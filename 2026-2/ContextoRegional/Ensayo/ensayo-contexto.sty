% ---------------------------------------------------------------- Portada
% Banda de muestra (2.2 cm): acento 40 % · tinta 13 % · tinte con puntos acento 26 % · blanco con puntos linea 21 %
\newcommand{\unison@bandapuntos}[3]{% #1 x inicial (fracción), #2 x final (fracción), #3 color
  \foreach \r in {0,1,2,3}{%
    \pgfmathsetmacro{\desp}{mod(\r,2)==1 ? 0.35 : 0}%
    \foreach \c in {0,...,30}{%
      \pgfmathsetmacro{\x}{#1*\paperwidth/1cm + 0.35 + \desp + \c*0.7}%
      \pgfmathparse{\x < #2*\paperwidth/1cm - 0.2 ? 1 : 0}%
      \ifnum\pgfmathresult=1
        \fill[#3] ([xshift=\x cm, yshift=-0.35cm-\r*0.5cm]current page.north west) circle (0.16cm);
      \fi
    }}}
