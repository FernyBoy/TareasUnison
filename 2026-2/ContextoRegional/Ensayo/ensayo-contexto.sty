\definecolor{azul}{HTML}{0400A3}
\definecolor{grismedio}{HTML}{6B6B6B}
\definecolor{azultinte}{HTML}{E6E6F6}
\definecolor{beigesombra}{HTML}{F2EEE3}
\colorlet{fondo}{blanco}
\colorlet{tinta}{grisoscuro}
\colorlet{acento}{azul}
\colorlet{linea}{grisclaro}
\colorlet{textosecundario}{grismedio}
