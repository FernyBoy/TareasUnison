\color{tinta}

% ---------------------------------------------------------------- Tipografía
% Requisito del profesor: Times New Roman 12, doble espacio.
\IfFontExistsTF{Times New Roman}{%
  \setmainfont{Times New Roman}%
}{%
  \setmainfont{texgyretermes}[Extension=.otf,
    UprightFont=*-regular, BoldFont=*-bold,
    ItalicFont=*-italic, BoldItalicFont=*-bolditalic]%
}
\setsansfont{texgyretermes}[Extension=.otf,
  UprightFont=*-regular, BoldFont=*-bold,
  ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
\renewcommand{\familydefault}{\rmdefault}
\doublespacing
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{0pt}

% Etiqueta del sistema (mayúsculas, espaciado 8 %)
\newcommand{\etiqueta}[1]{{\fontsize{9}{11}\selectfont\addfontfeature{LetterSpace=8}\MakeUppercase{#1}}}

% ---------------------------------------------------------------- Página
\geometry{letterpaper, left=3cm, right=2.5cm, top=2.5cm, bottom=3cm,
          headsep=0.8cm, footskip=0.9cm, headheight=30pt}

% ---------------------------------------------------------------- Títulos (sin número)
\setcounter{secnumdepth}{0}
\titleformat{\section}
  {\singlespacing\color{tinta}\fontsize{15}{18}\selectfont\bfseries}
  {}{0pt}{}[\vspace{3pt}{\color{acento}\rule{2.5cm}{1.5pt}}]
\titlespacing*{\section}{0pt}{18pt}{10pt}
\titleformat{\subsection}
  {\singlespacing\color{tinta}\fontsize{12}{15}\selectfont\bfseries}
  {}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}

% ---------------------------------------------------------------- Notas al pie (Chicago: espacio sencillo)
\renewcommand{\footnotelayout}{\color{tinta}}
\setlength{\footnotesep}{10pt}
\renewcommand{\footnoterule}{{\color{linea}\hrule width 4cm height 0.4pt}\vspace{6pt}}

% ---------------------------------------------------------------- Testimonio y citas en bloque
% Cita en bloque (Chicago: más de 4-5 líneas), a espacio sencillo y con sangría.
\newenvironment{citabloque}
  {\par\vspace{2pt}\begin{list}{}{\setlength{\leftmargin}{1.27cm}\setlength{\rightmargin}{0pt}
     \setlength{\topsep}{0pt}\setlength{\parsep}{6pt}}\item\relax\singlespacing}
  {\end{list}\vspace{8pt}\par}
% \testimonio{texto}{nota al pie}: las palabras del entrevistado, marcadas con un filete azul
\newcommand{\testimonio}[2]{%
  \par\vspace{2pt}\begin{list}{}{\setlength{\leftmargin}{1.27cm}\setlength{\topsep}{0pt}}\item\relax
  \singlespacing
  \begin{tikzpicture}[overlay]\fill[acento] (-0.45cm,0.32cm) rectangle (-0.39cm,-0.1cm);\end{tikzpicture}%
  #1\footnote{#2}\end{list}\vspace{8pt}\par}
% Marcador de texto pendiente
\newcommand{\pendiente}[1]{{\color{acento}[#1]}}

% ---------------------------------------------------------------- Bibliografía (Chicago 17)
\newenvironment{bibliografia}
  {\section{Bibliografía}\singlespacing
   \begin{list}{}{\setlength{\leftmargin}{1.27cm}\setlength{\itemindent}{-1.27cm}
     \setlength{\itemsep}{12pt}\setlength{\parsep}{0pt}}}
  {\end{list}}
\newcommand{\referencia}{\item\raggedright}

% ---------------------------------------------------------------- Encabezado / pie y fondo
\newcommand{\unisonmarcaagua}{escudo-matematicas-marca-agua.png}
\newcommand{\unisonopacidadmarca}{0.15}
\newlength{\unisonpasox}\setlength{\unisonpasox}{5.8mm}
\newlength{\unisonpasoy}\setlength{\unisonpasoy}{4.5mm}
\newlength{\unisonradio}\setlength{\unisonradio}{1.75mm}
\newlength{\unisonborde}\setlength{\unisonborde}{4mm}

\newcommand{\unison@franja}[2]{%
  \foreach \r in {0,1,2}{%
    \pgfmathsetmacro{\desp}{mod(\r,2)==1 ? 0.5 : 0}%
    \foreach \c in {0,...,38}{%
      \fill[puntos]
        ([xshift=(\c+\desp)*\unisonpasox, yshift=#2*(\unisonborde+\r*\unisonpasoy)]current page.#1)
        circle (\unisonradio);
    }}}

\newcommand{\unisonfondo}{%
  \begin{tikzpicture}[remember picture, overlay]
    \node[opacity=\unisonopacidadmarca, inner sep=0] at (current page.center)
      {\includegraphics[width=12cm]{\unisonmarcaagua}};
    \unison@franja{north west}{-1}
    \unison@franja{south west}{1}
  \end{tikzpicture}}

