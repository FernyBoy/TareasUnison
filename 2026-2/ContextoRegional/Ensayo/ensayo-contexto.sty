% ensayo-contexto.sty
% Sistema de diseño «Investigación UNISON» adaptado a un ensayo académico:
%   - fuente tipo Times New Roman (Times New Roman si está instalada; si no, TeX Gyre Termes)
%   - cuerpo a 12 pt, doble espacio, sangría de primera línea
%   - clase article, secciones sin número
%   - citas Chicago 17 (notas y bibliografía) escritas a mano
% Compilar con LuaLaTeX o XeLaTeX:  latexmk -lualatex ensayo.tex
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ensayo-contexto}[2026/11/25 Ensayo Contexto Regional (Investigación UNISON)]

\RequirePackage[spanish,es-tabla,es-noquoting]{babel}
\RequirePackage{fontspec}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{geometry}
\RequirePackage{graphicx}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{colortbl}
\RequirePackage{caption}
\RequirePackage{tikz}
\RequirePackage{setspace}
\RequirePackage{csquotes}
\RequirePackage{needspace}
\RequirePackage{etoolbox}
% Un título nunca queda solo al pie de la página
\AtEndPreamble{\preto\section{\needspace{8\baselineskip}}\preto\subsection{\needspace{6\baselineskip}}}
\RequirePackage[hang,flushmargin]{footmisc}
\RequirePackage{xurl}
\RequirePackage[hidelinks]{hyperref}

% ---------------------------------------------------------------- Color
