\titlespacing*{\subsection}{0pt}{12pt}{4pt}

% ---------------------------------------------------------------- Encabezado / pie y fondo
% Páginas de contenido: franja de puntos arriba y abajo, planos y de un solo
% tono (grisclaro al 25 % sobre blanco), y el escudo del Departamento de
% Matemáticas en gris como marca de agua al centro.
% La portada (estilo empty) no lleva nada de esto.
\colorlet{puntos}{grisclaro!25!white}
\newcommand{\unisonmarcaagua}{escudo-matematicas-marca-agua.png}
\newcommand{\unisonopacidadmarca}{0.15}
\newlength{\unisonpasox}\setlength{\unisonpasox}{5.8mm}   % paso horizontal (Dots.svg a 50 %)
\newlength{\unisonpasoy}\setlength{\unisonpasoy}{4.5mm}   % paso vertical
\newlength{\unisonradio}\setlength{\unisonradio}{1.75mm}  % radio del punto
\newlength{\unisonborde}\setlength{\unisonborde}{4mm}     % centro de la 1.ª fila al borde

% #1 = ancla (north west / south west), #2 = signo vertical (-1 arriba, 1 abajo)
\newcommand{\unison@franja}[2]{%
  \foreach \r in {0,1,2}{%
    \pgfmathsetmacro{\desp}{mod(\r,2)==1 ? 0.5 : 0}%
    \foreach \c in {0,...,38}{%
      \fill[puntos]
        ([xshift=(\c+\desp)*\unisonpasox, yshift=#2*(\unisonborde+\r*\unisonpasoy)]current page.#1)
        circle (\unisonradio);
    }}}

\newcommand{\unisonfondo}{%
  \begin{tikzpicture}[remember picture, overlay]
    \node[opacity=\unisonopacidadmarca, inner sep=0] at (current page.center)
      {\includegraphics[width=12cm]{\unisonmarcaagua}};
    \unison@franja{north west}{-1}
    \unison@franja{south west}{1}
  \end{tikzpicture}}

