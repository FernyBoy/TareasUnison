\fancyhead[C]{\unisonfondo}
\fancyfoot[LE,RO]{\color{acento}\fontsize{9}{11}\selectfont\bfseries\thepage}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyhead[C]{\unisonfondo}%
  \fancyfoot[LE,RO]{\color{acento}\fontsize{9}{11}\selectfont\bfseries\thepage}}

% ---------------------------------------------------------------- Figuras y tablas
\captionsetup{font={small,color=tinta}, labelfont={bf,color=acento},
              labelsep=period, justification=raggedright, singlelinecheck=false}
\captionsetup[table]{position=top, skip=6pt}
\captionsetup[figure]{position=bottom, skip=6pt}
\arrayrulecolor{tinta}
\setlength{\heavyrulewidth}{1pt}
\setlength{\lightrulewidth}{0.4pt}
\newcommand{\filasombra}{\rowcolor{beigesombra}}
% Columna de ancho flexible alineada a la izquierda (tabularx), sin huecos de justificado
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

% ---------------------------------------------------------------- Recuadros
\newtcolorbox{nota}[1][Nota]{enhanced, breakable, sharp corners, boxrule=0pt,
  colback=azultinte, colframe=azultinte, left=10pt, right=10pt, top=8pt, bottom=8pt,
  fontupper=\color{tinta},
  title={\fontsize{8}{10}\selectfont\addfontfeature{LetterSpace=8}\MakeUppercase{#1}},
  coltitle=acento, colbacktitle=azultinte, attach title to upper={\par\smallskip}}

\newtcolorbox{destacado}[1][]{enhanced, breakable, sharp corners, boxrule=0pt,
  colback=acento, colframe=acento, fontupper=\color{beige}\large\bfseries,
  left=12pt, right=12pt, top=10pt, bottom=10pt, #1}

% ---------------------------------------------------------------- Patrón de puntos
% \unisonpuntos[color]{columnas}{filas} — retícula escalonada del archivo Dots.svg
% (diámetro 0.7 cm, paso horizontal 1.17 cm, vertical 0.9 cm, filas alternas desplazadas medio paso)
\newcommand{\unisonpuntos}[3][grisclaro]{%
  \begin{tikzpicture}[x=1.166cm,y=-0.901cm]
    \foreach \r in {1,...,#3}{%
      \pgfmathsetmacro{\desp}{mod(\r,2)==0 ? 0.5 : 0}%
      \foreach \c in {1,...,#2}{%
        \fill[#1] (\c-\desp,\r) circle (0.35cm);
      }}
  \end{tikzpicture}}

% ---------------------------------------------------------------- Portada
% Datos de la portada (llamar antes de \unisonportada):
%   \portadaprograma{...}  \portadatitulo{...}  \portadasubtitulo{...}
%   \portadacurso{...}     \portadaprofesor{...} \portadafecha{...}
%   \portadaintegrante{Nombre}{Expediente}   (una vez por integrante)
% Requiere en el directorio: escudo-unison-tinta.png, escudo-matematicas-tinta.png,
% fachada-neoclasica.png (y escudo-matematicas-marca-agua.png para las páginas de contenido)
\newcommand{\unison@programa}{}\newcommand{\portadaprograma}[1]{\renewcommand{\unison@programa}{#1}}
\newcommand{\unison@titulo}{}\newcommand{\portadatitulo}[1]{\renewcommand{\unison@titulo}{#1}}
\newcommand{\unison@subtitulo}{}\newcommand{\portadasubtitulo}[1]{\renewcommand{\unison@subtitulo}{#1}}
\newcommand{\unison@curso}{}\newcommand{\portadacurso}[1]{\renewcommand{\unison@curso}{#1}}
\newcommand{\unison@profesor}{}\newcommand{\portadaprofesor}[1]{\renewcommand{\unison@profesor}{#1}}
\newcommand{\unison@fecha}{}\newcommand{\portadafecha}[1]{\renewcommand{\unison@fecha}{#1}}
\newcommand{\unison@integrantes}{}
\newcommand{\portadaintegrante}[2]{\g@addto@macro\unison@integrantes{#1 & {\color{textosecundario}#2}\\}}

% Puntos de la banda de portada: radio 0.16 cm, 4 filas a 0.5 cm, columnas a 0.7 cm,
% filas impares (1.ª y 3.ª) desplazadas 0.35 cm. #1 = esquina superior izquierda del bloque.
\newcommand{\unison@puntosbanda}[2]{%
  \foreach \r in {0,...,3}{%
    \pgfmathsetmacro{\desp}{mod(\r,2)==0 ? 0.35 : 0}%
    \foreach \c in {0,...,9}{%
      \fill[#2] ([xshift=(\c*0.7+\desp+0.35)*1cm, yshift=-(0.35+\r*0.5)*1cm]#1) circle (0.16cm);
    }}}

\newcommand{\unisonportada}{%
  \begin{titlepage}
    \newgeometry{left=2.5cm, right=2.5cm, top=0.6cm, bottom=2cm}
    \thispagestyle{empty}
    \noindent\begin{tikzpicture}[remember picture, overlay]
      % banda de muestra, 2.2 cm, a todo lo ancho: 40 % acento · 13 % tinta ·
      % 26 % azul-tinte con puntos acento · 21 % blanco con puntos linea
      \coordinate (bA) at (current page.north west);
      \coordinate (bB) at ([xshift=0.40\paperwidth]current page.north west);
      \coordinate (bC) at ([xshift=0.53\paperwidth]current page.north west);
      \coordinate (bD) at ([xshift=0.79\paperwidth]current page.north west);
      \fill[acento] (bA) rectangle ([yshift=-2.2cm]bB);
      \fill[tinta]  (bB) rectangle ([yshift=-2.2cm]bC);
      \fill[azultinte] (bC) rectangle ([yshift=-2.2cm]bD);
      \begin{scope}
        \clip (bC) rectangle ([yshift=-2.2cm]bD);
        \unison@puntosbanda{bC}{acento}
      \end{scope}
      \begin{scope}
        \clip (bD) rectangle ([yshift=-2.2cm]current page.north east);
        \unison@puntosbanda{bD}{linea}
      \end{scope}
      % escudos: arriba a la derecha, 2.4 cm de alto, bajo la banda
      \node[anchor=north east, inner sep=0] at ([xshift=-2.5cm,yshift=-3.0cm]current page.north east)
        {\includegraphics[height=2.4cm]{escudo-unison-tinta.png}\hspace{0.4cm}%
         \includegraphics[height=2.4cm]{escudo-matematicas-tinta.png}};
      % fachada: abajo a la derecha, 6.5 cm de ancho
      \node[anchor=south east, inner sep=0] at ([xshift=-2.5cm,yshift=1.2cm]current page.south east)
        {\includegraphics[width=6.5cm]{fachada-neoclasica.png}};
    \end{tikzpicture}\par\nointerlineskip
    \vspace*{5.9cm}
    {\color{acento}\fontsize{8}{10}\selectfont\addfontfeature{LetterSpace=8}\MakeUppercase{\unison@programa}\par}
    \vspace{10pt}
    {\color{tinta}\fontsize{28}{31}\selectfont\bfseries\unison@titulo\par}
    \vspace{8pt}
    {\color{acento}\rule{2.5cm}{2pt}\par}
    \vspace{10pt}
    {\color{textosecundario}\fontsize{13}{17}\selectfont\unison@subtitulo\par}
    \vspace{1.2cm}
    {\color{textosecundario}\fontsize{8}{10}\selectfont\addfontfeature{LetterSpace=8}\MakeUppercase{\unison@curso}\par}
    \vspace{6pt}
    {\color{tinta}\fontsize{11}{15}\selectfont Profesor: \unison@profesor\par}
    \vspace{14pt}
    {\color{tinta}\fontsize{11}{15}\selectfont
     \begin{tabular*}{10cm}{@{}l@{\extracolsep{\fill}}r@{}}
       \unison@integrantes
     \end{tabular*}\par}
    \vspace{14pt}
    {\color{textosecundario}\fontsize{9}{12}\selectfont\unison@fecha\par}
    \restoregeometry
  \end{titlepage}}

