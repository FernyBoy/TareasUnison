% ---------------------------------------------------------------- Títulos
\titleformat{\chapter}[display]
  {\color{tinta}\fontsize{22}{25}\selectfont\bfseries}
  {\color{acento}\fontsize{8}{10}\selectfont\addfontfeature{LetterSpace=8}\MakeUppercase{\chaptertitlename}~\thechapter}
